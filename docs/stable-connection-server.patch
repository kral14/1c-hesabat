+READ_ACTIONS = frozenset(('audit_history', 'get_audit_list', 'get_audit_diff', 'get_audit_events',
+    'get_documents_list', 'get_document_details', 'universal_report', 'universal_sales',
+    'generate', 'order_analysis'))
